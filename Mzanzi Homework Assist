<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Mzanzi Homework Assist - Grades 1-7</title>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
<style>
:root{--y:#ffcc00;--b:#000}
body{margin:0;font-family:Segoe UI,sans-serif;background:#fff5cc;color:#000}
header{background:var(--b);color:var(--y);padding:12px;text-align:center;position:sticky;top:0;z-index:10}
.badge{background:var(--y);color:#000;padding:6px 10px;border-radius:20px;font-weight:bold;font-size:12px;display:inline-block;margin:4px}
.card{background:#fff;border:2px solid #000;border-radius:14px;padding:14px;margin:10px;box-shadow:4px 4px 0 #000}
button{background:var(--b);color:var(--y);border:2px solid var(--b);padding:10px 14px;border-radius:10px;font-weight:bold;cursor:pointer;margin:4px}
button.yellow{background:var(--y);color:#000}
.tab{padding:8px;border:1px solid #000;border-radius:8px;margin:4px;display:inline-block;cursor:pointer}
.tab.active{background:var(--y)}
#preview{max-width:100%;border:3px solid var(--y);border-radius:10px;margin-top:8px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.hidden{display:none}
.high-contrast{background:#000!important;color:#fff!important}
.dyslexic{font-family:Comic Sans MS!important;letter-spacing:1.5px;background:#fef9e7!important}
</style>
</head>
<body>
<header>
<h2 style="margin:0">🇿🇦 MZANZI HOMEWORK ASSIST</h2>
<small>Grades 1-7 | English + 11 Languages</small><br>
<span id="trialBadge" class="badge">Loading trial...</span>
<div style="margin-top:6px">
<button onclick="toggleAccess('deaf')">🦻 Deaf</button>
<button onclick="toggleAccess('mute')">🤐 Mute-Free</button>
<button onclick="toggleAccess('blind')">👁️ Blind</button>
<button onclick="toggleAccess('dys')">📖 Dyslexia</button>
</div>
</header>

<div id="activateScreen" class="card hidden">
<h3>🔒 Activation Required</h3>
<p>Trial ended or not activated. Enter code from seller.</p>
<input id="phoneIn" placeholder="Phone e.g. 0821234567" style="width:90%;padding:10px;border:2px solid #000;border-radius:8px"><br><br>
<input id="codeIn" placeholder="Code e.g. MZANZI-0821234567-1234" style="width:90%;padding:10px;border:2px solid #000;border-radius:8px"><br><br>
<button onclick="doActivate()">Activate This Phone</button>
<p id="actMsg"></p>
<button class="yellow" onclick="buyNow()">Buy Now WhatsApp</button>
</div>

<div id="mainApp">
<div class="card" style="text-align:center">
<button onclick="showDash('child')">👧 Child</button>
<button onclick="showDash('parent')">👨 Parent</button>
<button onclick="showDash('teacher')">👩‍🏫 Teacher</button>
<button class="yellow" onclick="showAdmin()">💰 Seller Admin</button>
</div>

<div id="dash-child" class="card">
<h3>Child Dashboard - <span id="learningBadge" class="badge">Learning: Unknown</span></h3>
<div class="grid">
<select id="grade"><option>Grade 1</option><option>Grade 2</option><option>Grade 3</option><option>Grade 4</option><option>Grade 5</option><option>Grade 6</option><option>Grade 7</option></select>
<select id="subject"><option>Maths</option><option>English</option><option>Natural Science</option><option>Life Skills</option></select>
</div>
<input id="childName" placeholder="Child Name" style="width:95%;margin-top:8px;padding:10px;border:2px solid #000;border-radius:8px">
<select id="homeLang" style="width:98%;margin-top:8px;padding:10px;border:2px solid #000;border-radius:8px">
<option value="en">English (Master)</option><option value="zu">isiZulu</option><option value="xh">isiXhosa</option><option value="af">Afrikaans</option><option value="nso">Sepedi</option><option value="st">Sesotho</option><option value="tn">Setswana</option><option value="ss">siSwati</option><option value="ve">Tshivenda</option><option value="ts">Xitsonga</option><option value="nr">isiNdebele</option><option value="sasl">SA Sign Language</option>
</select>
<br><br>
<button onclick="startLearningTest()">🧠 Test My Learning Style (8 Q)</button>
<div id="learnTest" class="hidden"></div>
<hr>
<label><b>📸 Scan Homework Photo</b></label><br>
<input type="file" id="photo" accept="image/*" capture="environment">
<img id="preview" class="hidden">
<div id="ocrStatus"></div>
<div id="resultTabs" class="hidden">
<div><span class="tab active" onclick="openTab('original')">Original</span><span class="tab" onclick="openTab('trans')">Transliteration</span><span class="tab" onclick="openTab('meaning')">Meaning</span><span class="tab" onclick="openTab('translated')">Native</span></div>
<div id="tab-original" class="card"></div>
<div id="tab-trans" class="card hidden"></div>
<div id="tab-meaning" class="card hidden"></div>
<div id="tab-translated" class="card hidden"></div>
<button onclick="speakCurrent()">🔊 Read Aloud</button>
<h4>📚 Vocabulary</h4>
<div id="vocab"></div>
<h4>📝 4-Step Plan</h4>
<ol><li>Read <button onclick="checkStep(1)">Done</button></li><li>Meaning <button onclick="checkStep(2)">Done</button></li><li>Vocab <button onclick="checkStep(3)">Done</button></li><li>Practice <div id="practiceQ"></div><button onclick="checkStep(4)">Done</button></li></ol>
<div>Progress: <progress id="prog" value="0" max="4"></progress></div>
<button onclick="genWorksheet()">📄 Create 10 Practice</button>
<button onclick="whatsappReport()">🟢 WhatsApp Report</button>
</div>
<hr>
Self Score: <select id="selfScore"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select> <button onclick="finalCert()">Get Certificate</button>
<div id="cert" class="card hidden"></div>
</div>

<div id="dash-parent" class="card hidden">
<h3>Parent Assist</h3>
<p id="parentMethod">Method will show after learning test.</p>
<button onclick="speechSynthesis.speak(new SpeechSynthesisUtterance(document.getElementById('parentMethod').innerText))">🔊 Voice Instruction</button><br><br>
Parent Score: <select id="parentScore"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select>
<button onclick="alert('Saved')">Save</button>
<button class="yellow" onclick="showDash('child')">Back</button>
</div>

<div id="dash-teacher" class="card hidden">
<h3>Teacher Dashboard</h3>
<div id="teacherPatterns"></div>
<textarea placeholder="Feedback" style="width:95%;padding:10px"></textarea><br>
<button>Save Feedback</button>
<button class="yellow" onclick="showDash('child')">Back</button>
</div>

<div id="dash-admin" class="card hidden">
<h3>Seller Admin - Generate One-Phone Link</h3>
<input id="adminPhone" placeholder="Customer Phone 082..." style="width:90%;padding:10px;border:2px solid #000;border-radius:8px">
<button onclick="genLink()">Generate Link</button>
<p id="adminLink"></p>
</div>
</div>
</div>

<script>
let trialStart=localStorage.getItem('trialStart')||Date.now();
if(!localStorage.getItem('trialStart'))localStorage.setItem('trialStart',trialStart);
trialStart=parseInt(localStorage.getItem('trialStart'));
let scansToday=parseInt(localStorage.getItem('scansToday')||'0');
let lastScanDate=localStorage.getItem('lastScanDate')||new Date().toDateString();
let isPaid=localStorage.getItem('isPaid')==='true';
function updateTrialBadge(){
let daysPassed=Math.floor((Date.now()-trialStart)/(1000*60*60*24));
let daysLeft=10-daysPassed; let scansLeft=5-scansToday;
if(new Date().toDateString()!=lastScanDate){scansToday=0;localStorage.setItem('scansToday','0');localStorage.setItem('lastScanDate',new Date().toDateString());scansLeft=5;}
document.getElementById('trialBadge').innerText=isPaid?'✅ PAID UNLIMITED':`FREE TRIAL: Day ${daysPassed+1}/10 - ${scansLeft} left`;
if(!isPaid&&(daysPassed>=10))lockApp();
}
function lockApp(){document.getElementById('activateScreen').classList.remove('hidden');document.getElementById('mainApp').classList.add('hidden');}
function unlockApp(){document.getElementById('activateScreen').classList.add('hidden');document.getElementById('mainApp').classList.remove('hidden');}
updateTrialBadge();
function getFP(){return btoa(navigator.userAgent+screen.width+screen.height).slice(0,30);}
let params=new URLSearchParams(location.search);
if(params.get('activate')){
let code=params.get('activate');
let savedCode=localStorage.getItem('mzanzi_license');
if(!savedCode){localStorage.setItem('mzanzi_license',code);localStorage.setItem('licenseFP',getFP());localStorage.setItem('isPaid','true');isPaid=true;alert('Activated!');location.href=location.pathname;}
}
function doActivate(){
let code=document.getElementById('codeIn').value.trim().toUpperCase();
if(!code.startsWith('MZANZI-')){document.getElementById('actMsg').innerText='Invalid';return;}
localStorage.setItem('mzanzi_license',code);localStorage.setItem('licenseFP',getFP());localStorage.setItem('isPaid','true');isPaid=true;unlockApp();updateTrialBadge();
}
function buyNow(){window.open('https://wa.me/27820000000?text=Hi%20I%20want%20Mzanzi%20App','_blank');}
function showDash(which){document.querySelectorAll('[id^=dash-]').forEach(d=>d.classList.add('hidden'));document.getElementById('dash-'+which).classList.remove('hidden');}
function showAdmin(){document.querySelectorAll('[id^=dash-]').forEach(d=>d.classList.add('hidden'));document.getElementById('dash-admin').classList.remove('hidden');}
function genLink(){let p=document.getElementById('adminPhone').value.replace(/[^0-9]/g,'');let rnd=Math.floor(1000+Math.random()*9000);let code=`MZANZI-${p}-${rnd}`;let link=location.origin+location.pathname+'?activate='+code;document.getElementById('adminLink').innerHTML=`Code: <b>${code}</b><br>Link: <a href='${link}'>${link}</a><br><button onclick="navigator.clipboard.writeText('${link}')">Copy</button>`;}
function toggleAccess(t){if(t==='blind'){document.body.classList.toggle('high-contrast');}if(t==='dys'){document.body.classList.toggle('dyslexic');}if(t==='deaf'){alert('Deaf Mode ON');}if(t==='mute'){alert('Mute-Free Mode ON');}}
let currentTab='original';let currentText='';
function openTab(name){currentTab=name;document.querySelectorAll('[id^=tab-]').forEach(d=>d.classList.add('hidden'));document.getElementById('tab-'+name).classList.remove('hidden');}
function speakCurrent(){let txt=document.getElementById('tab-'+currentTab).innerText;let u=new SpeechSynthesisUtterance(txt);speechSynthesis.speak(u);}
document.getElementById('photo').addEventListener('change',async(e)=>{
if(!isPaid){let daysPassed=Math.floor((Date.now()-trialStart)/(1000*60*60*24));if(daysPassed>=10){lockApp();return;}if(scansToday>=5&&lastScanDate===new Date().toDateString()){alert('5 scans done today');return;}}
let file=e.target.files[0];if(!file)return;
let reader=new FileReader();reader.onload=function(ev){document.getElementById('preview').src=ev.target.result;document.getElementById('preview').classList.remove('hidden');};reader.readAsDataURL(file);
document.getElementById('ocrStatus').innerText='🔍 Reading...';
try{
let res=await Tesseract.recognize(file,'eng');let text=res.data.text;
document.getElementById('tab-original').innerText=text;
document.getElementById('tab-trans').innerText=text.toLowerCase()+' (easy read)';
document.getElementById('tab-meaning').innerText='CAPS '+document.getElementById('grade').value+' '+document.getElementById('subject').value+': Means -> '+text.slice(0,200)+'. Step1 Read, Step2 Understand, Step3 Try.';
let home=document.getElementById('homeLang').value;
document.getElementById('tab-translated').innerText='Translation ['+home+']: '+text;
let words=text.split(/\s+/).filter(w=>w.length>4).slice(0,5);
document.getElementById('vocab').innerHTML=words.map(w=>`<div class="card">📘 ${w} - Meaning: important word</div>`).join('');
document.getElementById('practiceQ').innerHTML='Q: What does '+(words[0]||'this')+' mean?';
document.getElementById('resultTabs').classList.remove('hidden');
document.getElementById('ocrStatus').innerText='✅ Done!';
scansToday++;localStorage.setItem('scansToday',scansToday);localStorage.setItem('lastScanDate',new Date().toDateString());updateTrialBadge();
}catch(err){document.getElementById('ocrStatus').innerText='Error: '+err.message;}
});
let vark={V:0,A:0,R:0,K:0};
function startLearningTest(){
let qs=[
{q:'Remember best?',opts:['See pics','Hear','Read','Do hands']},
{q:'5+3 stuck?',opts:['Draw dots','Say loud','Write again','Count fingers']},
{q:'New word?',opts:['Picture','Song','Copy','Blocks']},
{q:'Teacher explains?',opts:['Board','Story','Book','Try']},
{q:'Homework?',opts:['Color','Parent reads','List','Move']},
{q:'Spelling?',opts:['See shape','Aloud','Write 3x','Trace sand']},
{q:'Maths?',opts:['Chart','Song','Formula','Sticks']},
{q:'Bored?',opts:['Pics','Talk','Read','Play']}
];
let html='<h4>Learning Test</h4>';qs.forEach((qq,i)=>{html+=`<div class="card"><b>Q${i+1} ${qq.q}</b><br>`;qq.opts.forEach((o,j)=>{html+=`<button onclick="pickQ(${j})">${o}</button>`;});html+='</div>';});html+='<button class="yellow" onclick="finishTest()">Finish</button>';document.getElementById('learnTest').innerHTML=html;document.getElementById('learnTest').classList.remove('hidden');
}
function pickQ(j){if(j==0)vark.V++;if(j==1)vark.A++;if(j==2)vark.R++;if(j==3)vark.K++;}
function finishTest(){
let total=vark.V+vark.A+vark.R+vark.K||1;let type=`Visual ${Math.round(vark.V/total*100)}% | Auditory ${Math.round(vark.A/total*100)}% | Reading ${Math.round(vark.R/total*100)}% | Kinesthetic ${Math.round(vark.K/total*100)}%`;
localStorage.setItem('learningType',type);document.getElementById('learningBadge').innerText=type;
document.getElementById('parentMethod').innerText=`AI Report: Child learns best ${type}. Stick to one method 7 days. Plan: Day1-2 Visual, Day3 Practice, Day4 Parent, Day5 Teacher, Day6 Test, Day7 Certificate`;
document.getElementById('teacherPatterns').innerText=type;
document.getElementById('learnTest').classList.add('hidden');alert('Saved: '+type);
}
let steps=0;function checkStep(n){steps++;document.getElementById('prog').value=steps;}
function finalCert(){
let name=document.getElementById('childName').value||'Child';let grade=document.getElementById('grade').value;let score=document.getElementById('selfScore').value;let rating=score>=4?'Gold':score>=3?'Silver':'Bronze';
document.getElementById('cert').classList.remove('hidden');
document.getElementById('cert').innerHTML=`<h3>🏆 Certificate</h3><p>Name: ${name}<br>Grade: ${grade}<br>Score: ${score}/5<br>Learning: ${localStorage.getItem('learningType')||''}<br>Rating: ${rating}</p><button onclick="window.print()">Print</button>`;
}
function genWorksheet(){alert('10 practice questions generated');}
function whatsappReport(){let name=document.getElementById('childName').value||'Child';let t=`Mzanzi Report - ${name} Learning: ${localStorage.getItem('learningType')||'Unknown'}`;window.open('https://wa.me/?text='+encodeURIComponent(t),'_blank');}
if(params.get('admin')==='sell'){showAdmin();}
if(isPaid||Math.floor((Date.now()-trialStart)/(1000*60*60*24))<10){unlockApp();}else{lockApp();}
</script>
</body>
</html>
